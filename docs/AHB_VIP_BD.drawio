        <mxCell id="cmt" parent="1" style="text;html=1;fontSize=9;align=left;fontColor=#A7F3D0;fontFamily=Courier New;" value="@(vif.mon_cb);&#xa;if (vif.mon_cb.HREADY) begin&#xa;&#xa;  // 1) ONCE KAPAT&#xa;  if (pending != null) begin&#xa;    if (pending.write)&#xa;      pending.wdata = mon_cb.HWDATA;&#xa;    else&#xa;      pending.rdata = mon_cb.HRDATA;&#xa;    ap.write(pending);&#xa;    pending = null;&#xa;  end&#xa;&#xa;  // 2) SONRA AC&#xa;  if (mon_cb.HSEL &amp;&amp; mon_cb.HTRANS[1])&#xa;  begin&#xa;    pending = create(...);&#xa;    pending.addr  = mon_cb.HADDR;&#xa;    pending.write = mon_cb.HWRITE;&#xa;  end&#xa;end" vertex="1">
